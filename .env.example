# -----------------------------------------------------------------------------
# Browser application
# Copy only this section into .env.local for local frontend development.
# Variables prefixed with VITE_ are public and are included in the browser build.
# Never place secret or service-role keys in a VITE_ variable.
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_restricted_unsigned_upload_preset
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
VITE_TURNSTILE_VERIFY_URL=https://your-siteverify-worker.your-subdomain.workers.dev
VITE_STORE_ORIGIN=https://auntysalafashiongh.store
VITE_ADMIN_ORIGIN=https://admin.auntysalafashiongh.store

# -----------------------------------------------------------------------------
# Supabase Edge Function secrets
# Do not put these values in .env.local or expose them to the browser.
# Configure them with: npx supabase secrets set KEY=value
# -----------------------------------------------------------------------------

# Paystack secret key from the Paystack dashboard.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Comma-separated origins allowed to receive the Paystack checkout callback.
# Add the production origin after connecting the domain.
PAYMENT_CALLBACK_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://auntysalafashiongh.store,https://www.auntysalafashiongh.store

# Resend transactional-email credentials. Use a verified sender domain in production.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Aunty Sala Fashion Gh <orders@your-domain.com>"

# Public storefront origin used for absolute logo and action URLs in email clients.
PUBLIC_SITE_URL=https://auntysalafashiongh.store

# Meta WhatsApp Cloud API credentials.
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_GRAPH_API_VERSION=vXX.X

# An approved Meta message template containing one body text variable.
WHATSAPP_TEMPLATE_NAME=admin_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Notification recipients are configured in Admin Portal → Settings → Store,
# using notification_admin_email and notification_admin_whatsapp. They fall back
# to store_email and whatsapp_number when the notification-specific fields are blank.

# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_PUBLISHABLE_KEYS, and SUPABASE_SECRET_KEYS are managed automatically
# by hosted Supabase Edge Functions. Do not commit or manually expose them.

# -----------------------------------------------------------------------------
# Cloudflare setup tooling (not an application runtime variable)
# Keep this in your shell only while completing Turnstile setup.
# -----------------------------------------------------------------------------

# CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
