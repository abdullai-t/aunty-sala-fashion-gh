{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "turnstile-siteverify-aunty-sala-fashion-gh",
  "main": "src/index.js",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://admin.localhost:5173,http://localhost:5173,https://admin.auntysalafashiongh.store,https://aunty-sala-fashion-gh-store.pages.dev,https://auntysalafashiongh.store,https://www.auntysalafashiongh.store",
    "EXPECTED_HOSTNAMES": "127.0.0.1,admin.auntysalafashiongh.store,admin.localhost,aunty-sala-fashion-gh-store.pages.dev,auntysalafashiongh.store,localhost,www.auntysalafashiongh.store",
    "EXPECTED_ACTION": "turnstile-spin-v1"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
